{
  "name": "agentklar",
  "version": "0.1.0-beta.14",
  "private": true,
  "type": "module",
  "bin": {
    "agentklar": "bin/agentklar.mjs"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && vite build",
    "prepack": "npm run build",
    "smoke:package": "node scripts/package-smoke.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/server/server.js",
    "service": "node dist/server/launchd.js",
    "mcp": "node dist/server/mcp.js",
    "check": "tsc --noEmit",
    "refresh:benchmarks": "node --import tsx scripts/refresh-benchmarks.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "@hono/node-server": "2.1.3",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@modelcontextprotocol/server": "2.2.0",
    "@muse-code/sdk": "1.4.2",
    "hono": "4.13.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "skills": "1.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
